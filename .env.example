# Only needed outside Coolify. On Coolify, set these under the service's
# Environment Variables tab (SERVICE_PASSWORD_PASEO is generated for you).

# Tailscale auth key: https://login.tailscale.com/admin/settings/keys
# Use a reusable, non-ephemeral key. It is only used on first start.
TS_AUTHKEY=
# Machine name on your tailnet -> https://<name>.<tailnet>.ts.net
TS_HOSTNAME=paseo
# Headscale only: --login-server=https://headscale.example.com
TS_EXTRA_ARGS=

# Paseo image version (tags are X.Y.Z, no "v").
PASEO_VERSION=0.11.4

# Daemon password. Use a long random value: openssl rand -hex 32
SERVICE_PASSWORD_PASEO=

# Also allow pairing through Paseo's hosted relay (true/false).
PASEO_RELAY_ENABLED=false

# Timezone for schedules and logs.
TZ=UTC

# Commit identity for agents. Use your GitHub noreply address to keep your
# email out of public commits.
GIT_NAME=
GIT_EMAIL=

# Provider API keys for Pi. Use dedicated keys with a spending limit.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
